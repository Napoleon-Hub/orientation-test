<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.funnygaytest">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher_gachi"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_gachi_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="26">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme.Starting"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.yandex.mobile.ads.common.AdActivity"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name="com.unity3d.ads.adplayer.FullScreenWebViewDisplay"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/app_ad_id" />

        <meta-data
            android:name="com.yandex.mobile.ads.AUTOMATIC_SDK_INITIALIZATION"
            android:value="false" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

    <attribution android:tag="audio_tag" android:label="@string/app_name" />

</manifest>